    <string name="onboarding_ui_setup_profile_title">Your profile</string>
    <!-- Row 1 supporting line: what the profile step lets you choose. -->
    <string name="onboarding_ui_setup_profile_body">Choose a name, avatar and colour.</string>
    <!-- Row 2 title: the SMS permission step. -->
    <string name="onboarding_ui_setup_sms_title">SMS permissions</string>
    <!-- Row 2 supporting line: the step can be skipped. -->
    <string name="onboarding_ui_setup_sms_body">Optional, so transactions can be detected automatically.</string>
    <!-- Row 3 title: the first message scan. -->
    <string name="onboarding_ui_setup_scan_title">Message scan</string>
    <!-- Row 3 supporting line: what the first scan does. -->
