<resources>
    <string name="onboarding_ui_setup_profile_title">உங்கள் சுயவிவரம்</string>
    <string name="onboarding_ui_setup_profile_body">ஒரு பெயர், அவதார், நிறத்தைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="onboarding_ui_setup_sms_title">SMS அனுமதிகள்</string>
    <string name="onboarding_ui_setup_sms_body">விருப்பத்தேர்வு, பரிவர்த்தனைகளைத் தானாகக் கண்டறிய.</string>
    <string name="onboarding_ui_setup_scan_title">செய்தி ஸ்கேன்</string>
    <string name="onboarding_ui_setup_scan_body">உங்கள் தொலைபேசியில் ஏற்கனவே உள்ள வங்கிப் பரிவர்த்தனைகளை இறக்குமதி செய்யவும்.</string>
    <string name="onboarding_ui_setup_account_title">முதன்மைக் கணக்கு</string>
    <string name="onboarding_ui_setup_account_body">நீங்கள் அதிகம் பயன்படுத்தும் கணக்கைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="first_run_permission_read_title">SMS ஐப் படி</string>
    <string name="first_run_permission_read_body">உங்கள் தொலைபேசியில் ஏற்கனவே உள்ள வங்கிப் பரிவர்த்தனைச் செய்திகளைக் கண்டறியும்.</string>
    <string name="first_run_permission_receive_title">SMS ஐப் பெறு</string>
    <string name="first_run_permission_receive_body">புதிய வங்கிச் செய்திகள் வந்தவுடன் கவனிக்கும்.</string>
    <string name="first_run_permission_notifications_title">அறிவிப்புகள்</string>
    <string name="first_run_permission_notifications_body">பரிவர்த்தனை பதிவாகும்போது PennyWise உங்களுக்குத் தெரிவிக்கும்.</string>
