<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 23-30 (android:allowBackup is false, so this is a
   second line of defence). See data_extraction_rules.xml for API 31+.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="cloud_backup_secrets.xml" />
    <exclude domain="file" path="datastore/cloud_backup_settings.preferences_pb" />
</full-backup-content>
