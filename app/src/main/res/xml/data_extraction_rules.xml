<?xml version="1.0" encoding="utf-8"?><!--
   Android backup / device-transfer rules (API 31+).
   The cloud backup secrets file holds values sealed with an Android Keystore
   key that never leaves this device, so a copy elsewhere is unusable; it and
   the cloud connection settings are excluded so a new phone starts
   disconnected instead of with credentials it can't open.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud_backup_secrets.xml" />
        <exclude domain="file" path="datastore/cloud_backup_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud_backup_secrets.xml" />
        <exclude domain="file" path="datastore/cloud_backup_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
