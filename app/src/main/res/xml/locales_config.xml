<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages PennyWise offers under System settings → App languages
    (Android 13+). Same set as AppLanguage.supportedTags, which the in-app
    picker uses; AppLanguageConfigTest keeps the two in step. Only locales
    whose translations are complete enough to ship are listed — a values-*
    folder alone doesn't make a locale supported.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en-US" />
    <locale android:name="ar-SA" />
    <locale android:name="bn" />
    <locale android:name="cs-CZ" />
    <locale android:name="de-DE" />
    <locale android:name="fr-FR" />
    <locale android:name="gu" />
    <locale android:name="hi-IN" />
    <locale android:name="mr" />
    <locale android:name="pt-BR" />
    <locale android:name="pt-PT" />
    <locale android:name="ru-RU" />
    <locale android:name="ta" />
    <locale android:name="te" />
</locale-config>
